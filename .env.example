# Data-layer API keys. Copy to .env.local and fill in the ones you have.
# Every key is OPTIONAL — a missing key just means that source falls back to
# simulated (mock) data, clearly labeled in the UI. Nothing here is committed.

# Finnhub — equities quotes, company news, fundamentals, earnings, search.
# Free tier, no card. https://finnhub.io/  (note: OHLCV candles are paid)
FINNHUB_API_KEY=

# Twelve Data — OHLCV time series + quotes for non-crypto (primary charting).
# Free ~800 req/day, 8 req/min. https://twelvedata.com/
TWELVE_DATA_API_KEY=

# FRED (St. Louis Fed) — macro series (CPI, GDP, unemployment, yields).
# Free key, generous. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI — used from Phase 5 for the news feed. Free dev tier (localhost only).
# https://newsapi.org/
NEWSAPI_KEY=

# CoinGecko — crypto works WITHOUT a key on the public tier. A demo key only
# raises rate limits. https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Set to 1 to hide the dev-only per-datum LIVE/SIM/CACHE provenance tags.
# NEXT_PUBLIC_HIDE_SOURCE_TAGS=1
